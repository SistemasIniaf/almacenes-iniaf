# Despliegue (docker-compose.prod.yml). Copiar como `.env` EN LA RAIZ
# (no `.env.prod`: asi cae bajo la regla `.env` que el .gitignore ya tiene) y
# completar. Docker Compose lo carga solo, sin flags extra.
#
# Generar los secretos con: openssl rand -hex 32

# Postgres
POSTGRES_USER=almacenes
POSTGRES_PASSWORD=cambiar-password-segura
POSTGRES_DB=almacenes_db

# JWT (deben ser dos secretos DISTINTOS entre si)
JWT_ACCESS_SECRET=cambiar-en-produccion
JWT_REFRESH_SECRET=cambiar-en-produccion-distinto-al-anterior

# Usuario super_admin inicial (bootstrap, creado por el seed si no existe ninguno)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=cambiar-password-segura
SEED_ADMIN_NOMBRE="Administrador del Sistema"

# Respaldos (servicio `respaldos`): hora del dia (00-23, hora de Bolivia) y
# cuantos dias se conservan. Opcionales: sin definir, 02 y 14.
RESPALDO_HORA=02
RESPALDO_DIAS=14
